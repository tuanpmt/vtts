# Optional languages of the device front-end (runtime/include/vtts_langs.h): only those of the
# embedded models are compiled in (flash budget). VTTS_LANGS (cache variable, or the environment
# variable of the same name; build.sh passes it through) overrides: "all" builds every language, a
# list such as "zh;ja" exactly those; empty (default) derives the list from the token_set dim of
# model_s.vtts and model_m.vtts. Vietnamese and English (v1, vi-en) are always built.
set(VTTS_ALL_LANGS zh ko ja hi th es id pt fr de it tr ru pl ar fi el ms tl sw nl sv no)
# token_set code -> language (docs/model-format.md)
set(VTTS_CODE_3 zh)
set(VTTS_CODE_4 ko)
set(VTTS_CODE_5 ja)
set(VTTS_CODE_6 es)
set(VTTS_CODE_7 id)
set(VTTS_CODE_8 pt)
set(VTTS_CODE_9 th)
set(VTTS_CODE_10 hi)
set(VTTS_CODE_11 fr)
set(VTTS_CODE_12 de)
set(VTTS_CODE_13 it)
set(VTTS_CODE_15 tr)
set(VTTS_CODE_16 ru)
set(VTTS_CODE_17 pl)
set(VTTS_CODE_19 ar)
set(VTTS_CODE_21 nl)
set(VTTS_CODE_23 sv)
set(VTTS_CODE_24 no)
set(VTTS_CODE_25 fi)
set(VTTS_CODE_26 el)
set(VTTS_CODE_28 ms)
set(VTTS_CODE_29 tl)
set(VTTS_CODE_33 sw)
# files written before the dim: by vocab, only the sets that existed then (newer sets need the code)
set(VTTS_VOCAB_138 es)
set(VTTS_VOCAB_141 id)
set(VTTS_VOCAB_144 ja)
set(VTTS_VOCAB_150 pt)
set(VTTS_VOCAB_153 ko)
set(VTTS_VOCAB_157 hi)
set(VTTS_VOCAB_162 th)
set(VTTS_VOCAB_171 zh)

# Language of a model file from its header dims (runtime/src/vtts_model.c): "" for v1 / vi-en, an
# unknown set or a missing file.
function(vtts_model_lang path out)
    set(${out} "" PARENT_SCOPE)
    if(NOT EXISTS "${path}")
        return()
    endif()
    file(READ "${path}" hex LIMIT 8192 HEX)
    string(SUBSTRING "${hex}" 16 8 nd_le)
    set(n_dims 0)
    foreach(i 3 2 1 0)
        math(EXPR o "${i} * 2")
        string(SUBSTRING "${nd_le}" ${o} 2 b)
        math(EXPR n_dims "${n_dims} * 256 + 0x${b}")
    endforeach()
    string(HEX "token_set" ts_key)
    string(HEX "vocab" vocab_key)
    set(code 0)
    set(vocab 0)
    if(n_dims GREATER 0)
        math(EXPR last "${n_dims} - 1")
        foreach(i RANGE ${last})
            math(EXPR pos "(20 + 36 * ${i}) * 2")
            string(SUBSTRING "${hex}" ${pos} 64 name)
            string(REGEX REPLACE "(00)+$" "" name "${name}")
            math(EXPR vpos "${pos} + 64")
            string(SUBSTRING "${hex}" ${vpos} 8 le)
            set(v 0)
            foreach(j 3 2 1 0)
                math(EXPR o "${j} * 2")
                string(SUBSTRING "${le}" ${o} 2 b)
                math(EXPR v "${v} * 256 + 0x${b}")
            endforeach()
            if(name STREQUAL ts_key)
                set(code ${v})
            elseif(name STREQUAL vocab_key)
                set(vocab ${v})
            endif()
        endforeach()
    endif()
    if(code GREATER 0 AND code LESS 1000)
        if(DEFINED VTTS_CODE_${code})
            set(${out} ${VTTS_CODE_${code}} PARENT_SCOPE)
        endif()
    elseif(code EQUAL 0 AND DEFINED VTTS_VOCAB_${vocab})
        set(${out} ${VTTS_VOCAB_${vocab}} PARENT_SCOPE)
    endif()
endfunction()

if(NOT DEFINED VTTS_LANGS AND DEFINED ENV{VTTS_LANGS})
    set(VTTS_LANGS "$ENV{VTTS_LANGS}")
endif()
if(VTTS_LANGS STREQUAL "all")
    set(LANGS ${VTTS_ALL_LANGS})
elseif(VTTS_LANGS)
    string(REPLACE "," ";" LANGS "${VTTS_LANGS}")
else()
    set(LANGS "")
    foreach(mf model_s.vtts model_m.vtts)
        vtts_model_lang("${CMAKE_CURRENT_LIST_DIR}/${mf}" l)
        if(l)
            list(APPEND LANGS ${l})
        endif()
    endforeach()
    list(REMOVE_DUPLICATES LANGS)
endif()
set(LANG_DEFS "")
foreach(l ${VTTS_ALL_LANGS})
    string(TOUPPER ${l} L)
    if(l IN_LIST LANGS)
        list(APPEND LANG_DEFS "-DVTTS_ENABLE_${L}=1")
    else()
        list(APPEND LANG_DEFS "-DVTTS_ENABLE_${L}=0")
    endif()
endforeach()
foreach(l ${LANGS})
    if(NOT l IN_LIST VTTS_ALL_LANGS)
        message(FATAL_ERROR "VTTS_LANGS: unknown language '${l}' (one of: ${VTTS_ALL_LANGS}, or all)")
    endif()
endforeach()
message(STATUS "vtts: optional languages compiled in: ${LANGS} (vi, en always)")
# a new model re-runs this (its token set may differ)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
             "${CMAKE_CURRENT_LIST_DIR}/model_s.vtts" "${CMAKE_CURRENT_LIST_DIR}/model_m.vtts")
